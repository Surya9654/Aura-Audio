{
  "name": "aura-audio",
  "version": "3.1.0",
  "description": "Aura 3.1 — Ultra-Premium Lossless Audiophile Player",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --dir",
    "build": "electron-builder --win"
  },
  "keywords": [
    "flac",
    "audiophile",
    "dac",
    "hi-res",
    "lossless",
    "audio-player"
  ],
  "author": "Aura Studio",
  "license": "MIT",
  "dependencies": {
    "lucide": "^1.61.0",
    "music-metadata": "^12.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.aura.audio3",
    "productName": "Aura 3.1",
    "copyright": "Copyright © 2026 Aura Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "BackDrop/**/*",
      "DefaultCover/**/*",
      "demo_lossless/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura 3.1"
    }
  }
}
